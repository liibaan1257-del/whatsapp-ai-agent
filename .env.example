# Copy to .env.local and fill in real values. Never commit real secrets.

# --- Supabase (Project Settings -> API Keys) --------------------------------
# Public: safe in the browser (Row Level Security protects the data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY secret: lets the webhook save messages and bookings.
# Never prefix with NEXT_PUBLIC_ and never use it in client components.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Claude) — console.anthropic.com -> API Keys -----------------
ANTHROPIC_API_KEY=

# --- WhatsApp Cloud API (Meta) — developers.facebook.com --------------------
# Any random string you choose; enter the same value in Meta's webhook setup.
WHATSAPP_VERIFY_TOKEN=
# App Settings -> Basic -> App secret (verifies X-Hub-Signature-256).
WHATSAPP_APP_SECRET=
# Token used to send replies (System User token recommended).
WHATSAPP_ACCESS_TOKEN=
# Optional: Graph API version used to send replies.
WHATSAPP_GRAPH_VERSION=v23.0
# Optional (testing only): override the Graph API base URL.
# WHATSAPP_API_BASE=https://graph.facebook.com
