# Copy to .env.local and fill in real values. Never commit real secrets.

# --- Supabase (Project Settings -> API Keys) --------------------------------
# Public: safe in the browser (Row Level Security protects the data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY secret: lets the webhook save messages and bookings.
# Never prefix with NEXT_PUBLIC_ and never use it in client components.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Claude) — console.anthropic.com -> API Keys -----------------
ANTHROPIC_API_KEY=

# --- WhatsApp Cloud API (Meta) — developers.facebook.com --------------------
# Any random string you choose; enter the same value in Meta's webhook setup.
WHATSAPP_VERIFY_TOKEN=
# App Settings -> Basic -> App secret (verifies X-Hub-Signature-256).
WHATSAPP_APP_SECRET=
# Token used to send replies (System User token recommended).
WHATSAPP_ACCESS_TOKEN=
# Optional: Graph API version used to send replies.
WHATSAPP_GRAPH_VERSION=v23.0

# Optional: Twilio as the WhatsApp provider instead of (or next to) Meta.
# Twilio Console → Account Info. Secret: server only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional (testing only): override the Graph API base URL.
# WHATSAPP_API_BASE=https://graph.facebook.com

# Optional: contact address shown on the /privacy page (public, not a secret).
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional: your WhatsApp number for "Chat with us on WhatsApp" (home + privacy page), e.g. +252612345678.
NEXT_PUBLIC_CONTACT_WHATSAPP=

# Daily appointment reminders (vercel.json cron). Any long random string;
# Vercel sends it to /api/cron/reminders. Secret.
CRON_SECRET=

# Optional: email the operator when someone signs up (Resend API key, sending access).
# Goes to NOTIFY_EMAIL, else NEXT_PUBLIC_CONTACT_EMAIL.
RESEND_API_KEY=
NOTIFY_EMAIL=
